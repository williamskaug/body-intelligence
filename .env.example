# =============================================================================
# Body Intelligence — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# From Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, used only in trusted server contexts
# (e.g. signup-trigger seeding). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string — used by Drizzle Kit for migrations.
# From Supabase project settings → Database → Connection string (pooler off,
# session mode for migrations).
DATABASE_URL=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public origin of this deployment. Local dev: http://localhost:3000
# Production: https://<your-vercel-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OAuth Authorization Server
# -----------------------------------------------------------------------------
# 32+ random bytes, base64-encoded. Signs JWTs and hashes tokens at rest.
# Generate with: `openssl rand -base64 48`
OAUTH_SIGNING_SECRET=

# Token TTLs in seconds. Defaults: 1h access, 30d refresh.
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# -----------------------------------------------------------------------------
# Signup abuse hardening (open public signup is enabled)
# -----------------------------------------------------------------------------
# Cloudflare Turnstile (free, privacy-respecting). Use the keys from
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Note: SMTP for Supabase Auth (magic-link emails) is configured in the Supabase
# dashboard, not here. Use Resend or similar — Supabase's default sender has
# poor inbox placement once you have real users.

# -----------------------------------------------------------------------------
# Connector credentials
# -----------------------------------------------------------------------------
# BI never holds credentials for external services. Garmin, Strava, Apple Health,
# Whoop, etc. live as separate Claude connectors (their own MCPs); each manages
# its own auth. There is nothing to set here.

# -----------------------------------------------------------------------------
# Backfill scripts (one-shot, server-only)
# -----------------------------------------------------------------------------
# Anthropic API key — used ONLY by scripts/backfill-meal-macros.ts to estimate
# kcal/protein/carbs/fat from existing meals.description when authoritative
# values are missing. The runtime app does not call the Anthropic API.
ANTHROPIC_API_KEY=
